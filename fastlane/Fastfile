      },
      {
        'name' => 'Branch',
        'value' => 'Develop'
      }
    ],
    theme_color: '321244',
    use_markdown: true
  )
  end


  desc "Deploy a new version to the App Center"
  lane :testcase do |options|
      env = options[:env]
      puts "[#{options[:env].upcase}]"
  end

  desc "Deploy a new version to the App Center"
  lane :publish_appcenter do |options|
    #TODO fastlane lane env 
      pathApk = "./build/app/outputs/flutter-apk/app-release.apk"
      puts "pathApk = " + pathApk
      apiToken = "1e147a9c50de6a7ccbda935b8968be79559104fe"
      appName = "HRM"
      appcenter_upload(
      api_token: apiToken,
      owner_name: "FSEL", 
      app_name: appName,
      app_os: "Android",
      app_platform: "Java",
      apk: pathApk,
      release_notes:"[[#{git_branch.upcase}] : #{options[:notes]}",
      notify_testers: true,
      should_clip: false,
      timeout: 600,
      )
      UI.message("[#{git_branch.upcase}] : #{lane_context[SharedValues::APPCENTER_DOWNLOAD_LINK]}")
  end
end

